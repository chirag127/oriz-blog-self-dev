---
/*
 * Wordmark — practicelog ("Field Log").
 *
 * The mark is a small graph-paper cell with a marked (filled) corner — the
 * signature streak-cell shrunk to a logotype. Wordmark set in Fraunces
 * display, lowercase, tight. "practice" in ink, "log" in sap green — the two
 * halves of the promise: the doing, and the record of it.
 */

interface Props {
  /** Sub-section name — rendered after a `/` separator. */
  subtitle?: string
  /** Display size in CSS pixels. */
  size?: number
  /** Wrap the mark in an <a href="/"> — defaults to '/' when subtitle is set. */
  href?: string | null
  /** Render as <h1> (the masthead) rather than <div>. */
  asHeading?: boolean
}

const { subtitle, size = 96, href = null, asHeading = false } = Astro.props
const Tag = asHeading ? 'h1' : ('div' as const)
const label = subtitle ? `practicelog / ${subtitle}` : 'practicelog'
---

{
  href ? (
    <a class="wordmark-link" href={href} aria-label={label}>
      <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
        <span class="wordmark-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <rect x="1.5" y="1.5" width="21" height="21" rx="4" class="glyph-box" />
            <path d="M6.5 12.5 L10.5 16.5 L18 8" class="glyph-check" />
          </svg>
        </span>
        <span class="wordmark-word">
          <span class="wordmark-a">practice</span><span class="wordmark-b">log</span>
        </span>
        {subtitle && (
          <>
            <span class="wordmark-sep" aria-hidden="true">/</span>
            <span class="wordmark-sub">{subtitle}</span>
          </>
        )}
      </Tag>
    </a>
  ) : (
    <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
      <span class="wordmark-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <rect x="1.5" y="1.5" width="21" height="21" rx="4" class="glyph-box" />
          <path d="M6.5 12.5 L10.5 16.5 L18 8" class="glyph-check" />
        </svg>
      </span>
      <span class="wordmark-word">
        <span class="wordmark-a">practice</span><span class="wordmark-b">log</span>
      </span>
      {subtitle && (
        <>
          <span class="wordmark-sep" aria-hidden="true">/</span>
          <span class="wordmark-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  )
}

<style>
  .wordmark-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 560;
    font-size: var(--wm-size, 96px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .wordmark-glyph {
    display: inline-flex;
    width: 0.92em;
    height: 0.92em;
    flex: 0 0 auto;
  }
  .wordmark-glyph svg { width: 100%; height: 100%; overflow: visible; }
  .glyph-box {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 2;
  }
  .glyph-check {
    fill: none;
    stroke: var(--ember);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wordmark-link:hover .glyph-box { stroke: var(--brand); }
  .wordmark-word { display: inline-flex; }
  .wordmark-a { color: var(--ink); }
  .wordmark-b { color: var(--brand); }
  .wordmark-sep {
    margin-inline: 0.2em;
    color: var(--ink-mute);
    font-weight: 400;
  }
  .wordmark-sub {
    color: var(--ember);
    font-family: var(--font-utility);
    font-weight: 600;
    font-size: 0.62em;
    letter-spacing: 0.02em;
    text-transform: lowercase;
  }
</style>
