---
/*
 * Footer — colophon for practicelog ("Field Log").
 *
 * Journal archetype: the page doesn't end in a 4-column link farm. It ends
 * like the last page of a notebook — a torn top edge, one pull-quote written
 * small, a single line of colophon links, and the legal fine print. Sits in
 * the same narrow ruled column as the rest of the sheet.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { getTagsWithCounts, slugifyTag } from '~/lib/blog'

const tags = (await getTagsWithCounts()).slice(0, 10).map(({ tag }) => tag)
---
<footer class="colophon" role="contentinfo">
  <div class="colophon-tear" aria-hidden="true"></div>

  <blockquote class="colophon-quote">
    <span aria-hidden="true" class="cq-mark">“</span>
    You don't rise to your goals. You fall to your systems.
    <span class="cq-attr">— the whole point of a log</span>
  </blockquote>

  {tags.length > 0 && (
    <nav class="colophon-tags" aria-label="Topics">
      {tags.map((t) => (
        <a href={`/tags/${slugifyTag(t)}/`}>#{t}</a>
      ))}
    </nav>
  )}

  <p class="colophon-links">
    <a href="/blog/">Entries</a>
    <a href="/series/">Threads</a>
    <a href="/archive/">Archive</a>
    <a href="/now/">Now</a>
    <a href="/about/">About</a>
    <a href="/rss.xml">RSS</a>
  </p>

  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-self-dev"
    appName="practicelog"
    bio="A working log of habits, focus, and follow-through — by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>

<style>
  .colophon {
    max-width: var(--journal-col, 660px);
    margin: 4rem auto 0;
    padding: 0 1rem 3rem var(--journal-gutter, 2.5rem);
    color: var(--ink);
  }
  .colophon-tear {
    height: 10px;
    margin-bottom: 2rem;
    background:
      linear-gradient(-45deg, transparent 33.333%, var(--paper) 33.333%, var(--paper) 66.667%, transparent 66.667%),
      linear-gradient(45deg, transparent 33.333%, var(--paper) 33.333%, var(--paper) 66.667%, transparent 66.667%);
    background-size: 12px 20px;
    background-color: var(--paper-2);
    border-top: 1px solid var(--rule-strong);
  }
  .colophon-quote {
    margin: 0 0 1.75rem;
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(1.25rem, 3.2vw, 1.6rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 34ch;
  }
  .cq-mark { color: var(--ember); font-size: 1.4em; line-height: 0; margin-right: 2px; }
  .cq-attr {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-utility);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
  }
  .colophon-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    margin-bottom: 1.5rem;
  }
  .colophon-tags a {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--ink-mute);
    text-decoration: none;
  }
  .colophon-tags a:hover { color: var(--ember); }
  .colophon-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.25rem;
    margin: 0 0 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .colophon-links a {
    font-family: var(--font-utility);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
  }
  .colophon-links a:hover { color: var(--brand); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 640px) {
    .colophon { padding-left: var(--journal-gutter, 1.75rem); }
  }
</style>
