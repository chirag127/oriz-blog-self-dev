---
/*
 * Header — diary masthead for practicelog ("Field Log").
 *
 * Journal archetype: no top-nav bar. A quiet page-top plate that reads like the
 * inside cover of a notebook — the ruled red margin line runs down the left,
 * the title sits hand-set, a dateline stamps the day. All navigation lives in
 * the <JournalNav /> index tab (top-right), NOT here.
 *
 *   │  practicelog                                            ▟ Index │
 *   │  a working log · Day N · Wednesday 12 August 2026               │
 */
import JournalNav from '~/components/JournalNav.astro'
import StatusBanner from '~/components/StatusBanner.astro'

const started = new Date('2024-01-01')
const now = new Date()
const day = Math.floor((now.valueOf() - started.valueOf()) / 86_400_000)
const stamp = now.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<StatusBanner />
<JournalNav />

<header class="masthead" transition:persist="masthead">
  <div class="masthead-col">
    <a class="masthead-brand" href="/" aria-label="practicelog — front page">
      <span class="masthead-word"><span class="mw-a">practice</span><span class="mw-b">log</span></span>
    </a>
    <p class="masthead-line">
      <span class="ml-tag">a working log</span>
      <span class="ml-sep" aria-hidden="true">·</span>
      <span class="ml-day">Day {day.toLocaleString()}</span>
      <span class="ml-sep" aria-hidden="true">·</span>
      <time datetime={now.toISOString().slice(0, 10)}>{stamp}</time>
    </p>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    max-width: var(--journal-col, 660px);
    margin-inline: auto;
    padding: clamp(2.25rem, 6vw, 3.5rem) 0 1.5rem;
  }
  .masthead-col {
    /* sit inside the ruled column: text starts after the red margin line */
    padding-left: var(--journal-gutter, 2.5rem);
    padding-right: 1rem;
  }
  .masthead-brand { display: inline-block; text-decoration: none; }
  .masthead-word {
    font-family: var(--font-display);
    font-weight: 560;
    font-size: clamp(2.4rem, 8vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .mw-a { color: var(--ink); }
  .mw-b { color: var(--brand); }
  .masthead-brand:hover .mw-b { color: var(--ember); }

  .masthead-line {
    margin: 0.75rem 0 0;
    font-family: var(--font-utility);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  .ml-day { color: var(--ember); font-weight: 600; }
  .ml-sep { color: var(--rule-strong); }

  @media (max-width: 640px) {
    .masthead-col { padding-left: var(--journal-gutter-sm, 1.75rem); }
  }
</style>
