---
/**
 * PostCard — log-entry row for practicelog ("Field Log").
 *
 * Distinct from generic siblings: each post renders as a DATED LOG ENTRY
 * with a handwritten-weight entry number in the red margin, a topic-coloured
 * left stripe, and a one-line dek. The date is hung in the left margin like
 * a diary datestamp; the title is the entry headline. No rounded card, no
 * shadow — just the ruled-notebook row.
 *
 * Used by every listing (index, tag, category, related).
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
  /** sequential position in the list — shown as a log entry number */
  index?: number
}

const { post, index } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const catHref = `/categories/${slugifyTag(category)}/`
const vert = postVertical(post)
const entryNum = typeof index === 'number' ? String(index + 1).padStart(3, '0') : null
---

<article class="log-entry" data-vertical={vert}>
  {entryNum && <span class="log-num mono" aria-hidden="true">{entryNum}</span>}
  <a class="log-link" href={href}>
    <span class="log-stripe" aria-hidden="true"></span>
    <span class="log-body">
      <span class="log-meta mono">
        <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
        <span class="log-sep" aria-hidden="true">·</span>
        <a class="log-cat" href={catHref} tabindex="-1" aria-hidden="true">{category}</a>
        {readingTime && <><span class="log-sep" aria-hidden="true">·</span><span class="log-rt">{readingTime}</span></>}
      </span>
      <span class="log-title">{title}</span>
      <span class="log-dek">{description}</span>
    </span>
    <span class="log-arrow mono" aria-hidden="true">→</span>
  </a>
  <a class="log-cat-link" href={catHref} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  .log-entry {
    position: relative;
    display: grid;
    grid-template-columns: var(--log-num-w, 0) minmax(0, 1fr);
    border-top: 1px solid var(--rule);
    --v: var(--v-personal);
  }
  .log-entry[data-vertical='dev'] { --v: var(--v-dev); }
  .log-entry[data-vertical='finance'] { --v: var(--v-finance); }
  .log-entry[data-vertical='culture'] { --v: var(--v-culture); }
  .log-entry[data-vertical='health'] { --v: var(--v-health); }

  /* entry number — hung in the margin like a diary entry index */
  .log-num {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding-top: 1.15rem;
    padding-right: 0.75rem;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: color-mix(in oklab, var(--rule-strong) 80%, transparent);
    line-height: 1;
    min-width: 2.5rem;
  }

  .log-link {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
    padding: 1rem 0.25rem 1.1rem 0;
    text-decoration: none;
    color: var(--ink);
    transition: background var(--dur-fast) ease;
  }
  .log-link:hover { background: color-mix(in oklab, var(--brand) 4%, transparent); }
  @media (prefers-reduced-motion: reduce) { .log-link { transition: none; } }

  /* thin coloured left stripe — vertical identity marker */
  .log-stripe {
    flex: 0 0 3px;
    border-radius: 2px;
    background: var(--v);
    margin-block: 0.1rem;
    opacity: 0.55;
    transition: opacity var(--dur-fast) ease;
  }
  .log-link:hover .log-stripe { opacity: 1; }

  .log-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .log-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-mute);
  }
  .log-sep { color: var(--rule-strong); }
  .log-cat { color: var(--v); font-weight: 500; text-transform: uppercase; font-size: 10px; letter-spacing: 0.14em; }
  .log-rt { color: var(--ink-mute); }

  .log-title {
    font-family: var(--font-display);
    font-weight: 540;
    font-size: 1.175rem;
    letter-spacing: -0.012em;
    line-height: 1.22;
    color: var(--ink);
    display: block;
  }
  .log-link:hover .log-title { color: var(--brand); }

  .log-dek {
    display: block;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--ink-mute);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
  }

  /* arrow — appears on hover */
  .log-arrow {
    flex: 0 0 auto;
    align-self: center;
    font-size: 13px;
    color: var(--ink-mute);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .log-link:hover .log-arrow { opacity: 1; transform: translateX(0); }
  @media (prefers-reduced-motion: reduce) { .log-arrow { transition: none; opacity: 1; transform: none; } }

  /* Sibling deep-link to category — visually hidden, keyboard reachable. */
  .log-cat-link {
    position: absolute;
    inset: 0 0 auto auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .log-cat-link:focus-visible {
    width: auto;
    height: auto;
    clip: auto;
    top: 1rem;
    right: 0;
    padding: 0.125rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  /* When the list provides entry numbers, shift the grid columns */
  .log-entry:has(.log-num) {
    --log-num-w: 2.5rem;
  }
</style>
