---
/*
 * BaseLayout — JOURNAL / LINED-PAPER shell for every practicelog route.
 *
 * One narrow ruled column on lined-paper texture. No top-nav bar, no sidebar,
 * no bottom bar: navigation is folded into the <JournalNav /> index tab that
 * ships inside <Header />. Diary masthead on top, quiet colophon at the foot.
 */
import '~/styles/global.css'
import '~/styles/oriz-ui-overrides.css'
import 'katex/dist/katex.min.css'
import '~/styles/tokens.css'
import { ClientRouter } from 'astro:transitions'
import ConsentBanner from '~/components/chrome/ConsentBanner.astro'
import FeedDiscovery from '~/components/FeedDiscovery.astro'
import Footer from '~/components/Footer.astro'
import Header from '~/components/Header.astro'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  image?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  /** Accepted for back-compat with pages that pass it; the journal shell has no sidebar. */
  hideSidebar?: boolean
}

const {
  title = 'practicelog — a working log of habits, focus, and follow-through',
  description = "A working log of habits, focus, and follow-through — the practices that hold when motivation is gone. By Chirag Singhal.",
  canonical = `https://self-dev-blog.oriz.in${Astro.url.pathname}`,
  noindex = false,
  jsonLd,
  image,
  type = 'website',
  pubDate,
  updatedDate,
} = Astro.props

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN
const ga4Id = import.meta.env.PUBLIC_GA4_ID
const ogImage = image ? new URL(image, 'https://self-dev-blog.oriz.in').toString() : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="practicelog" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chirag127" />

    <!-- Apply the saved reading theme before paint so the editorial surface never flashes. -->
    <script is:inline>
      {`(() => {
        try {
          const theme = localStorage.getItem('oriz:theme')
          if (theme && theme !== 'auto' && ['light', 'dark', 'sepia', 'hc'].includes(theme)) {
            document.documentElement.dataset.theme = theme
          }
        } catch (_) {}
      })()`}
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f5f6f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <FeedDiscovery />

    <ClientRouter />

    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
      />
    )}

    {adsenseClient && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}

    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconToken}"}`}
      />
    )}

    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script is:inline define:vars={{ ga4Id }}>
          {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga4Id);`}
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="journal-sheet">
      <Header />
      <main id="main" class="journal-column"><slot /></main>
      <Footer />
    </div>
    <ConsentBanner />

    <script>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </body>
</html>

<style>
  /* ── The sheet: one lined-paper page down the middle ──────────────────
     Horizontal rules every 1.9rem + a warm-clay vertical margin line at the
     gutter. The whole column is the notebook; masthead, entries and colophon
     all sit on the same ruled surface. */
  :global(:root) {
    --journal-col: 920px;
    --journal-gutter: 2.5rem;
    --journal-gutter-sm: 1.75rem;
    --journal-line: 1.9rem;
  }
  .journal-sheet {
    min-height: 100vh;
    background:
      /* red left-margin rule */
      linear-gradient(
        to right,
        transparent 0,
        transparent calc(50% - (var(--journal-col) / 2) + var(--journal-gutter) - 2px),
        color-mix(in oklab, var(--ember) 55%, transparent) calc(50% - (var(--journal-col) / 2) + var(--journal-gutter) - 2px),
        color-mix(in oklab, var(--ember) 55%, transparent) calc(50% - (var(--journal-col) / 2) + var(--journal-gutter) - 1px),
        transparent calc(50% - (var(--journal-col) / 2) + var(--journal-gutter) - 1px)
      ),
      /* horizontal ruled lines */
      repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent calc(var(--journal-line) - 1px),
        color-mix(in oklab, var(--rule) 65%, transparent) calc(var(--journal-line) - 1px),
        color-mix(in oklab, var(--rule) 65%, transparent) var(--journal-line)
      );
    background-position: 0 0, 0 0;
  }
  .journal-column {
    max-width: min(92vw, var(--journal-col));
    margin-inline: auto;
    padding: 0 1rem 0 var(--journal-gutter);
  }
  @media (max-width: 640px) {
    :global(:root) { --journal-gutter: 1.75rem; }
    /* on narrow screens the margin rule hugs the left edge, not the center */
    .journal-sheet {
      background:
        linear-gradient(
          to right,
          transparent 0,
          transparent calc(var(--journal-gutter) - 2px),
          color-mix(in oklab, var(--ember) 55%, transparent) calc(var(--journal-gutter) - 2px),
          color-mix(in oklab, var(--ember) 55%, transparent) calc(var(--journal-gutter) - 1px),
          transparent calc(var(--journal-gutter) - 1px)
        ),
        repeating-linear-gradient(
          to bottom,
          transparent 0,
          transparent calc(var(--journal-line) - 1px),
          color-mix(in oklab, var(--rule) 65%, transparent) calc(var(--journal-line) - 1px),
          color-mix(in oklab, var(--rule) 65%, transparent) var(--journal-line)
        );
    }
    .journal-column { padding-left: var(--journal-gutter); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
</style>
